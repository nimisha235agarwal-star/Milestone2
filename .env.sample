# ============================================
# Groww Mutual Fund FAQ Assistant - Environment
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.sample .env

# --- Chroma Cloud Configuration ---
# Get these from https://trychroma.com after creating a database
# Run: chroma login && chroma db create <name> && chroma db connect <name> --env-file
CHROMA_API_KEY=""
CHROMA_TENANT=""
CHROMA_DATABASE=""

# --- Groq LLM Configuration ---
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=""
